{
  "name": "study-notes",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "forwardPorts": [5173, 1323],

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "clinyong.vscode-css-modules",
        "golang.go",
        "humao.rest-client"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:USERPROFILE}\\.gitconfig,target=/root/.gitconfig,type=bind,readonly"
  ],
  "postCreateCommand": "git config --local core.autocrlf input"
}
